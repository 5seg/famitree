# API サーバー (server/index.ts)。コピーして .env にする。.env はコミットしない
PORT=3000
# SQLite と写真の保存先。未設定なら server/data
DATA_DIR=./server/data
# 写真 URL を絶対化するための API の公開 URL。ローカルなら http://localhost:3000
PUBLIC_URL=https://famitree-api.5seg.top
# CORS で許可するフロントのオリジン (カンマ区切り。*. でサブドメインのワイルドカード)
ALLOWED_ORIGINS=https://famitree.pages.dev,https://*.famitree.pages.dev

# Web Push の VAPID 鍵。未設定なら通知は無効。生成: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://famitree-api.5seg.top

# フロントのビルド時 (Pages)。API のオリジン。未設定なら同一オリジン (/api) を叩く
VITE_API_BASE=https://famitree-api.5seg.top
